# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database — cPanel MySQL
DATABASE_URL="mysql://DB_USER:DB_PASS@localhost:3306/mantram360"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=30d

# Admin JWT (longer lived for admin sessions)
ADMIN_JWT_SECRET=change_this_admin_secret_too
ADMIN_JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+91XXXXXXXXXX

# Twilio WhatsApp
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# App timezone
TZ=Asia/Kolkata
TEMPLE_TIMEZONE=Asia/Kolkata
